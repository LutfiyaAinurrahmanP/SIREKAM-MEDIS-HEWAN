// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/backend/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Roles {
  admin
  staff
  veterinarian
  client
}

enum Gender {
  male
  female
  unknown
}

enum MedicinesType {
  tablets // tablet
  syrups // sirup
  ointments // salep
  injections // injeksi
  others // lainnya
}

enum MedicineUnit {
  tablets // tablet
  ml // mili
  vials // vial
  bottles // botol
  pcs // pcs
}

enum AppointmentStatus {
  scheduled
  completed
  canceled
  no_show
}

enum MedicalRecordsStatus {
  draft
  final
}

enum PaymentStatus {
  pending
  partial
  paid
}

enum PaymentMethod {
  transfer
  card
  cash
  other
}

model User {
  id Int @id @default(autoincrement())
  username String @unique @db.VarChar(64)
  fullname String @db.VarChar(64)
  email String @unique @db.VarChar(64)
  password String @db.VarChar(128)
  role Roles
  phone String @db.VarChar(14)
  token String? @db.VarChar(128)
  created_at DateTime? @default(now()) 
  updated_at DateTime? @updatedAt

  pets Pets[]
  treatment_notes TreatmentNotes[]
  transactions Transactions[]
  medical_records MedicalRecords[]
  prescriptions Prescriptions[]
  appointments Appointments[]
  @@map("users")
}

model AnimalTypes {
  id Int @id @default(autoincrement())
  name String @unique @db.VarChar(64)
  description String? @db.Text
  created_at DateTime? @default(now())
  updated_at DateTime? @updatedAt

  pets Pets[]
  @@map("animal_types")
}

model Pets {
  id Int @id @default(autoincrement())
  owner_id Int
  name String @db.VarChar(64)
  animal_type_id Int
  breed String? @db.VarChar(64)
  gender Gender 
  birth_date DateTime? @db.Date
  weight Decimal @db.Decimal(5,2)
  color String? @db.VarChar(64)
  notes String? @db.Text
  created_at DateTime? @default(now())
  updated_at DateTime? @updatedAt

  appointments Appointments[]
  medical_records MedicalRecords[]
  transactions Transactions[]

  owner User @relation(fields: [owner_id], references: [id])
  animal_type AnimalTypes @relation(fields: [animal_type_id], references: [id])
  @@map("pets")
}

model Medicines {
  id Int @id @default(autoincrement())
  name String @db.VarChar(64)
  code String @unique @db.VarChar(64)
  type MedicinesType
  unit MedicineUnit
  stock_qty Int @default(0)
  price Decimal @db.Decimal(10,2)
  is_active Boolean @default(true)
  created_at DateTime? @default(now())
  updated_at DateTime? @updatedAt

  prescription_items PrescriptionItems[]

  @@map("medicines")
}

model Prescriptions {
  id Int @id @default(autoincrement())
  medical_record_id Int
  veterinarian_id Int
  notes String? @db.Text
  created_at DateTime? @default(now())
  updated_at DateTime? @updatedAt

  prescription_items PrescriptionItems[]

  veterinarian User @relation(fields: [veterinarian_id], references: [id])
  medical_record MedicalRecords @relation(fields: [medical_record_id], references: [id])

  @@map("prescriptions")
}

model PrescriptionItems {
  id Int @id @default(autoincrement())
  prescription_id Int
  medicine_id Int
  dosage String? @db.VarChar(64)
  frequency String? @db.VarChar(64)
  duration_days Int?
  instructions String? @db.Text
  created_at DateTime? @default(now())
  updated_at DateTime? @updatedAt

  prescription Prescriptions @relation(fields: [prescription_id], references: [id])
  medicine Medicines @relation(fields: [medicine_id], references: [id])
  @@map("prescription_items")
}

model ServiceCategories {
  id Int @id @default(autoincrement())
  name String @db.VarChar(64)
  description String? @db.Text
  price Decimal @db.Decimal(10,2)
  is_active Boolean @default(true)
  created_at DateTime? @default(now())
  updated_at DateTime? @updatedAt

  medical_records MedicalRecords[]

  @@map("service_categories")
}

model Appointments {
  id Int @id @default(autoincrement())
  pet_id Int
  created_by Int
  schedule_date DateTime @db.Date
  schedule_time DateTime @db.Time
  status AppointmentStatus @default(scheduled)
  reason String? @db.Text
  notes String? @db.Text
  created_at DateTime? @default(now())
  updated_at DateTime? @updatedAt

  medical_records MedicalRecords[]

  pet Pets @relation(fields: [pet_id], references: [id])
  createdBy User @relation(fields: [created_by], references: [id])
  @@map("appointments")
}

model MedicalRecords {
  id Int @id @default(autoincrement())
  pet_id Int
  service_id Int
  appointment_id Int?
  veterinarian_id Int
  visit_date DateTime @db.Date
  subject String? @db.Text
  objective String? @db.Text
  assessment String? @db.Text
  plan String? @db.Text
  weight Decimal? @db.Decimal(5,2)
  temperature_celsius Decimal? @db.Decimal(4,2)
  next_visit_date DateTime? @db.Date
  status MedicalRecordsStatus @default(draft)
  created_at DateTime? @default(now())
  updated_at DateTime? @updatedAt

  treatment_notes TreatmentNotes[]
  transactions Transactions[]
  prescriptions Prescriptions[]

  pet Pets @relation(fields: [pet_id], references: [id])
  service ServiceCategories @relation(fields: [service_id], references: [id])
  appointment Appointments? @relation(fields: [appointment_id], references: [id])
  veterinarian User @relation(fields: [veterinarian_id], references: [id])
  @@map("medical_records")
}

model TreatmentNotes {
  id Int @id @default(autoincrement())
  created_by Int
  medical_record_id Int
  notes String @db.Text
  created_at DateTime? @default(now())
  updated_at DateTime? @updatedAt

  createdBy User @relation(fields: [created_by], references: [id])
  medical_record MedicalRecords @relation(fields: [medical_record_id], references: [id])
  @@map("treatment_notes")
}

model Transactions {
  id Int @id @default(autoincrement())
  created_by Int
  pet_id Int
  medical_record_id Int?
  total_amount Decimal @db.Decimal(10,2)
  paid_amount Decimal @db.Decimal(10,2)
  payment_status PaymentStatus @default(pending)
  payment_method PaymentMethod @default(cash)
  invoice_date DateTime @db.Date 
  notes String? @db.Text
  created_at DateTime? @default(now())
  updated_at DateTime? @updatedAt

  createdBy User @relation(fields: [created_by], references: [id])
  pet Pets @relation(fields: [pet_id], references: [id])
  medical_record MedicalRecords? @relation(fields: [medical_record_id], references: [id])
  @@map("transactions")
}